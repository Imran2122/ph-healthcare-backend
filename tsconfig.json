{
  "compilerOptions": {
    "module": "ESNext",
    "types": ["node"],
    "moduleResolution": "bundler",
    "target": "ES2023",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0"
  },

  "include": ["src","prisma.config.ts"],
  "exclude": ["node_module", "dist"]
}
